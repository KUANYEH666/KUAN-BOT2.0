# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here

# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# TDX (運輸資料流通服務) API 設置
# 申請位置：https://tdx.transportdata.tw/
# 建議使用 Client ID / Client Secret 取得 Access Token
TDX_CLIENT_ID=your_tdx_client_id_here
TDX_CLIENT_SECRET=your_tdx_client_secret_here
# 可選：若已有可用 Bearer token 或舊式 API Key，可填以下任一項
TDX_ACCESS_TOKEN=
TDX_API_KEY=

# 臺鐵即時資料快取，建議 30-60 秒
TRA_REALTIME_CACHE_TTL_MS=45000
# 臺鐵票價快取，建議 7-30 天
TRA_FARE_CACHE_TTL_DAYS=14

# 其他配置
NODE_ENV=development
